# =============================================================================
# Nexora — root .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# Environment files — NEVER commit real secrets
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local
# .env.example is intentionally NOT listed here — it contains only placeholders
# and should be committed so contributors know what vars to set.

# ---------------------------------------------------------------------------
# SQLite database — ships empty; regenerated by init_db() on first startup
# ---------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
*.so
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# ---------------------------------------------------------------------------
# Resume upload temp files (runtime artifacts — never source control)
# backend/app/temp/ directory itself is tracked via .gitkeep
# ---------------------------------------------------------------------------
backend/app/temp/*
!backend/app/temp/.gitkeep

# ---------------------------------------------------------------------------
# ChromaDB local vector store (ephemeral, regenerated per session)
# ---------------------------------------------------------------------------
chroma_db/
.chroma/

# ---------------------------------------------------------------------------
# Frontend build artifacts
# (frontend/node_modules and dist are also covered by frontend/.gitignore,
#  but listed here for clarity at the root level)
# ---------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
node_modules/

# ---------------------------------------------------------------------------
# OS and editor cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# JetBrains IDEs
.idea/
*.iml
*.iws

# VS Code (workspace settings can be committed if your team uses them,
# but personal/local settings should not be)
.vscode/
!.vscode/extensions.json

# ---------------------------------------------------------------------------
# Logs and runtime output
# ---------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# NOTE: .kiro/specs/ is intentionally NOT listed here.
# That folder contains the hackathon spec documents and must be committed.
# ---------------------------------------------------------------------------
