# Nexora LLM Provider Configuration
# Copy this file to .env and fill in your values.

# LLM_PROVIDER: "ollama" (default) or "gemini"
#   ollama — local Ollama server, fully offline, no API key needed.
#   gemini — Google Gemini API, requires GEMINI_API_KEY.
LLM_PROVIDER=ollama

# GEMINI_API_KEY: required only when LLM_PROVIDER=gemini.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# GEMINI_MODEL: override the default Gemini model (optional).
# Default: gemini-3.5-flash (verified working). Alternatives: gemini-3.6-flash, gemini-3.7-flash.
GEMINI_MODEL=gemini-3.5-flash
