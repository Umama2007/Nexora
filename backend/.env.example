# Nexora LLM Provider Configuration
# Copy this file to .env and fill in your values.

# LLM_PROVIDER: "ollama" (default) or "gemini"
#   ollama — local Ollama server, fully offline, no API key needed.
#   gemini — Google Gemini API (cloud), requires GEMINI_API_KEY.
#            Designed for low-memory deploys (e.g. Render free tier, 512 MB).
LLM_PROVIDER=ollama

# GEMINI_API_KEY: required only when LLM_PROVIDER=gemini.
# Get a key at https://aistudio.google.com/apikey
# For automatic failover across multiple free-tier keys, also set:
#   GEMINI_API_KEY_1=...
#   GEMINI_API_KEY_2=...
#   GEMINI_API_KEY_3=...
# The backend reads as many as are set (up to 99). When one key hits its
# quota/rate limit, the request automatically retries with the next key.
GEMINI_API_KEY=

# GEMINI_MODEL: override the default Gemini completion model (optional).
# Default: gemini-3.5-flash (verified working). Alternatives: gemini-3.6-flash, gemini-3.7-flash.
# Embeddings always use gemini-embedding-001 (stable, separate from this setting).
GEMINI_MODEL=gemini-3.5-flash

# --- Ollama-mode extra packages ---
# The interview RAG system in Ollama mode needs sentence-transformers + chromadb.
# These are NOT in requirements.txt (they'd bloat Gemini-mode deploys to ~400 MB).
# Install them only if you plan to use Ollama mode interviews:
#   pip install sentence-transformers chromadb
